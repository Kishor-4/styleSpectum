# StyleSpectrum Environment Variables Template
PORT=5000

# Base MongoDB Connection String (will automatically branch into stylespectrum_customer and stylespectrum_shopkeeper)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/stylespectrum?retryWrites=true&w=majority

# Optional: Explicit individual URIs if using separate clusters
# MONGODB_CUSTOMER_URI=mongodb+srv://.../stylespectrum_customer?retryWrites=true&w=majority
# MONGODB_SHOPKEEPER_URI=mongodb+srv://.../stylespectrum_shopkeeper?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=replace_this_with_a_secure_random_hex_string
